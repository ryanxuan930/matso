// MATSO 資料庫權威 schema（SPEC_FULL.md §15）
// v0 draft — 由任務卡 M0-4 以 `prisma migrate dev` 驗證與定稿。
// 注意：部分新表（Order, IntelContact 等）刻意使用純 String id 欄位而非 @relation，
// M0-4 定稿時再決定哪些需要 FK 完整性（Ledger 類表傾向鬆耦合以利歸檔）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. System & Environment Configurations
// ==========================================

model SystemConfiguration {
  id                String   @id @default(uuid())
  versionName       String
  simTickRateMs     Int      @default(1000)
  globalRules       Json // Dynamic ROE & active plugin registries
  integrationConfig Json // Endpoints for Weather Module & ATAK servers
  updatedAt         DateTime @updatedAt
}

model WargameSession {
  id                String      @id @default(uuid())
  name              String
  scenarioId        String?
  masterSeed        BigInt // P4 可重現性：所有 RNG 的根種子
  mode              SessionMode @default(REALTIME)
  startTime         DateTime    @default(now())
  endTime           DateTime?
  archivedAt        DateTime? // #31 封存時間（歷史頁）：有值＝已封存（活模擬凍結、可還原/刪除）
  worldStartTime    DateTime? // 想定世界初始日期時間（in-world t=0；供 #6 日照/晨昏推算；可編輯 #16）
  currentWeather    Json // Processed output strictly from the Weather Module
  // #6：允許「自行編輯本軍編裝（ORBAT）」的陣營清單（White Cell 設定）。null/[] = 僅白軍可編。
  orbatEditFactions Json?
  // #98 陣營關係矩陣（SPEC §12.1）：三元組陣列 [[a, b, "ALLIED"|"NEUTRAL"|"HOSTILE"], …]，對稱。
  // 想定載入時寫入；**null = 未宣告 → 全 HOSTILE 預設**（既有局零遷移、語義與過去一致）。
  // 存在此處而非只靠 scenarioId，是因為：無想定的局也要能有關係、且白軍可局中宣戰/停火。
  factionRelations  Json?
  // WP-A3 禁射區（SPEC_V2 §6 WP-A3）：[{name, zone_class: NO_STRIKE|RESTRICTED_FIRE, geometry}]。
  // 想定載入時寫入、白軍可局中增修；**null = 無禁射區**（既有局零遷移）。
  // 存宣告而非 h3 格集——格集由幾何於讀取時導出（見 core/app/orders/no_strike.py）。
  noStrikeZones     Json?
  // WP-B6 想定交戰規則（SPEC_FULL §11.1／§10 G4）：{default_fire_policy, weapon_restrictions}。
  // 想定 roe.yaml 載入時寫入、白軍可局中修改；**null = 無 ROE 限制**（既有局零遷移）。
  // 生效於裁決層（被禁武器不開火）與 submit 端（明確指名被禁武器即拒）——見 core/app/orders/roe.py。
  roe               Json?
  // WP-B6 想定機動覆寫（overrides/mobility_matrix.json）：**局部**覆寫，深合併於出貨預設。
  // null = 用出貨預設（既有局零遷移）。⚠ 不得改變可通行性——A* 在 terrain 服務看不到本欄。
  mobilityOverrides Json?
  /// 陣地變換（WP-C10.5）：{enabled, missions_before_move, min_km, max_km}。
  /// NULL＝停用（既有局零遷移）。開局從想定快照一份，不即時讀想定。
  survivabilityMove Json?
  /// 所屬演習（WP-B1）。**NULL＝獨立局**——與掛演習之前的行為完全相同。
  /// 刻意不設 FK：刪演習不該連坐刪局（`deleteExercise` 只把本欄轉 NULL）。
  exerciseId        String?
  /// 本局在演習中的角色（預推/正式/分析）。NULL＝未指定（含獨立局）。
  sessionRole       SessionRole?
  /// MSEL 腳本事件（WP-B2）：[{id, once, trigger, inject}]。開局從想定快照一份。
  /// NULL＝無 MSEL（既有局零遷移）。**在此之前想定的 msel 從未被持久化**——
  /// 載得進來、卻沒有任何一條路把它帶進執行期，等於整個 MSEL 是死的。
  msel              Json?

  units                        TacticalUnit[]
  eventLogs                    TacticalEventLog[]
  mapFeatures                  MapFeature[]
  /// 申請單配額快照（WP-B5.2）。**開局時從想定複製一份**，不是每次即時讀想定——
  /// 想定可能在演習進行中被編修或刪除，即時讀會讓已開的局配額被追溯改掉。
  /// null＝未宣告＝不限（既有局語義）。
  requestQuotas                Json?
  /// 曲射火協（WP-B5.3）：開局時從想定快照。true＝ARTILLERY/MISSILE 的 ENGAGE 須掛
  /// 已核准的 FIRE_SUPPORT 申請單。null/false＝不設限（既有局零變更）。
  indirectFireRequiresApproval Boolean?
}

// 地圖標註/工事：武器據點、障礙、建築、控制措施等（點/線/面 + 影響範圍 + 屬性）。
// ownerFaction=WHITE_CELL → 共同/ground truth（全體可見）；其餘＝該陣營標注（fog of war，後端過濾）。
model MapFeature {
  id               String         @id @default(uuid())
  sessionId        String
  session          WargameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind             String // OBSTACLE / BUILDING / WEAPON_EMPLACEMENT / CONTROL_MEASURE / TERRAIN / ANNOTATION
  geometryType     String // POINT / LINE / POLYGON
  geometry         Json // GeoJSON coordinates（依 geometryType：Point=[lng,lat]、Line=[[lng,lat]…]、Polygon=[[[lng,lat]…]]）
  ownerFaction     String // 擁有陣營（WHITE_CELL＝共同）
  label            String?
  influenceRadiusM Float? // 影響範圍（公尺；點/線常用）
  weaponTemplateId String? // WEAPON_EMPLACEMENT 連結的武器範本（EquipmentTemplate.id）
  attributes       Json           @default("{}") // 額外屬性（passable/damage/color…）
  createdAt        DateTime       @default(now())
}

enum SessionMode {
  REALTIME
  WEGO
  IGO_UGO
}

// ==========================================
// 2. Tactical Units & Fractal Command Chain
// ==========================================

enum UnitLevel {
  THEATER
  CORPS
  DIVISION
  BRIGADE
  BATTALION
  COMPANY
  PLATOON
  SQUAD
  FIRETEAM
  INDIVIDUAL
}

enum CommsState {
  ONLINE
  DEGRADED
  OFFLINE
}

model TacticalUnit {
  id        String         @id @default(uuid())
  sessionId String
  session   WargameSession @relation(fields: [sessionId], references: [id])

  designation String
  unitLevel   UnitLevel
  faction     String // 想定定義字串 id（§12.1/ADR 006）

  // Fractal Hierarchy (Self-Referential)
  parentId String?
  parent   TacticalUnit?  @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subUnits TacticalUnit[] @relation("UnitHierarchy")

  // 固定單位（指揮部/後勤/陣地等）：不接受 MOVE 令、不會被派去移動或機動交戰（劇本 ORBAT 設定）。
  isFixed Boolean @default(false)

  // Extensible Properties & Live Telemetry
  attributes          Json       @default("{}")
  currentLat          Float? // WGS84
  currentLng          Float? // WGS84
  elevation           Float? // 由 Terrain Module 查詢
  // 戰力（真實化交戰）：authorizedStrength＝滿編戰力（TO&E 分母，不遞減）；currentStrength＝當前
  // 戰力（唯一權威量，交戰扣此）；healthStatus 改為由 currentStrength/authorizedStrength 經凹形
  // 折點曲線導出的「效能%」（供 COP 顯示，不再是權威 HP）。人員數供顯示/回報（可空）。
  authorizedStrength  Float      @default(100.0)
  currentStrength     Float      @default(100.0)
  personnelAuthorized Int?
  personnelCurrent    Int?
  healthStatus        Float      @default(100.0)
  commsStatus         CommsState @default(ONLINE)

  equipment  EquipmentInstance[]
  eventsInit TacticalEventLog[]  @relation("Initiator")
  eventsRecv TacticalEventLog[]  @relation("Target")
}

// ==========================================
// 3. Weaponeering & Hardware RAG Database
// ==========================================

model EquipmentTemplate {
  id        String              @id @default(uuid())
  name      String
  category  String // KINETIC, SENSOR, COMMS, LOGISTICS, DRONE
  baseStats Json                @default("{}") // 需通過 contracts/weaponeering.schema.json 驗證
  instances EquipmentInstance[]
}

model EquipmentInstance {
  id           String            @id @default(uuid())
  templateId   String
  template     EquipmentTemplate @relation(fields: [templateId], references: [id])
  ownerId      String
  owner        TacticalUnit      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  currentState Json              @default("{}")
  // #30 建制數量：一個 instance 代表 N 件同型裝備（如班內 7 支步槍）；驅動 squad 火力容量。
  quantity     Int               @default(1)
}

// ==========================================
// 4. Immutable Event Ledger (For AAR & Replay)
// ==========================================
// append-only：應用層與 DB 權限層皆禁止 UPDATE/DELETE（SPEC_FULL §15.3）

model TacticalEventLog {
  id        String         @id @default(uuid())
  sessionId String
  session   WargameSession @relation(fields: [sessionId], references: [id])
  seq       Int // session 內單調遞增，由 Kernel 發號
  tick      Int
  timestamp DateTime       @default(now())
  eventType String

  initiatorId String?
  initiator   TacticalUnit? @relation("Initiator", fields: [initiatorId], references: [id])
  targetId    String?
  target      TacticalUnit? @relation("Target", fields: [targetId], references: [id])

  // Context Snapshots for accurate AAR generation
  weatherSnapshot Json
  terrainModifier Float

  // AI Adjudication & Diagnostics
  reasoningChain String? @db.Text // Mandatory CoT (IHL compliance & transparency)
  aiDecision     Json
  damageCalc     Float?
  // 非證據性診斷（TICK_OVERRUN 耗時、ROLLBACK 中繼資料等）。
  // ⚠ 刻意「不」納入 hash chain：可含非決定性值（牆鐘），入鏈會破壞重播可重現性（O1.7/R8）。
  detail         Json?

  // Tamper-evident hash chain (SPEC_FULL §15.3)
  prevHash String
  selfHash String

  @@unique([sessionId, seq])
  @@index([sessionId, timestamp])
}

// ==========================================
// 5. Users & RBAC (SPEC_FULL §12)
// ==========================================

enum UserRole {
  EXERCISE_DIRECTOR
  WHITE_CELL_STAFF
  COMMANDER
  STAFF
  OBSERVER
  ANALYST
  ADMIN
}

model User {
  id           String               @id @default(uuid())
  username     String               @unique
  passwordHash String // Argon2id
  totpSecret   String?
  role         UserRole
  createdAt    DateTime             @default(now())
  participants SessionParticipant[]
}

model SessionParticipant {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  sessionId String
  faction   String // 想定定義字串 id（SPEC §12.1/ADR 006）；WHITE_CELL 保留字
  role      UserRole
  // 席位（WP-B5.1，[JCATS-F p.9–10]）：同陣營內的參謀分工，與 role 正交。
  // **可為 NULL＝未指派席位 → 權限完全沿用 role 的既有規則**。
  // 既有局零遷移：上線時所有既有參與者都是 NULL，行為與改版前逐項相同。
  seatRole  SeatRole?
  unitScope Json // 可指揮的單位 id 白名單（null = 全軍）

  @@unique([userId, sessionId])
}

/// C2 信文（WP-B5.2，[JCATS-F p.10–14]）——席位之間的文書往返。
/// 受眾＝ toSeat（指定席位）或 toFaction（整個陣營）；過濾一律在後端（紅線 3）。
model Message {
  id         String      @id @default(uuid())
  sessionId  String
  kind       MessageKind
  fromUserId String
  fromSeat   SeatRole? // null＝寄件者未指派席位
  toSeat     SeatRole? // null＝發給整個陣營
  toFaction  String
  refId      String? // 關聯的申請單（REQUEST/APPROVAL）
  body       String      @db.Text
  tick       Int
  readAt     DateTime?
  createdAt  DateTime    @default(now())

  @@index([sessionId, toFaction])
}

/// 申請單（WP-B5.2，[JCATS-A p.13,15,26]）——下級送出、上級核覆、核准後轉為效果。
/// 核覆留痕（誰、第幾 tick）供 AAR 重建 [JCATS-F p.14] 的可評分事件鏈。
model Request {
  id              String        @id @default(uuid())
  sessionId       String
  faction         String
  kind            RequestKind
  status          RequestStatus @default(PENDING)
  params          Json
  requestedById   String
  requestedSeat   SeatRole?
  requestedAtTick Int
  decidedById     String?
  decidedAtTick   Int?
  decisionNote    String?       @db.Text
  createdAt       DateTime      @default(now())

  @@index([sessionId, faction])
}

enum MessageKind {
  FREE_TEXT
  REQUEST
  APPROVAL
  REPORT
}

enum RequestKind {
  AIR_RECON
  FIRE_SUPPORT
  RESUPPLY_VOUCHER
  /// 臨機火力申請（WP-C10.1）：觀測單位對已發現目標叫火力。
  /// 與 FIRE_SUPPORT 分開：後者是「解鎖一次曲射任務」的授權，
  /// 這個是「我看到目標、請對這裡射擊」的具體任務單。
  CALL_FOR_FIRE
}

/// PENDING →（核覆）→ APPROVED / DENIED；APPROVED →（用掉）→ EXPENDED（終態）。
/// 「已核准」與「還沒用掉」是兩件事——合併會讓一張核准單被用兩次。
enum RequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPENDED
}

/// 席位（WP-B5.1）：同一陣營內的參謀席次。與 UserRole 正交——
/// UserRole 說「這個帳號在系統裡是誰」，SeatRole 說「他在這局坐哪個位子」。
enum SeatRole {
  COMMANDER
  S2_INTEL
  S3_OPS
  FSO_FIRES
  S4_LOG
  OBSERVER
}

// ==========================================
// 6. Scenario / Orders / Intel (SPEC_FULL §15.2)
// ==========================================

model Scenario {
  id          String   @id @default(uuid())
  name        String
  version     String
  packageBlob Bytes // Phase 1；>16MB 改物件儲存（見 ADR backlog）
  checksum    String
  createdBy   String
  createdAt   DateTime @default(now())
}

enum OrderStatus {
  PENDING
  VALIDATED
  EXECUTING
  COMPLETED
  REJECTED
  CANCELLED
}

model Order {
  id             String      @id @default(uuid())
  sessionId      String
  issuerId       String // SessionParticipant id 或 AI role 名
  unitId         String
  orderType      String // MOVE, ENGAGE, RECON, RESUPPLY, POSTURE, ...
  payload        Json
  status         OrderStatus @default(PENDING)
  precheck       Json? // 物理預檢結果快照
  issuedAtTick   Int
  resolvedAtTick Int?

  @@index([sessionId, status])
}

enum IntelFidelity {
  DETECTED
  CLASSIFIED
  IDENTIFIED
}

model IntelContact {
  id           String        @id @default(uuid())
  sessionId    String
  faction      String // 「誰看到的」——想定定義字串 id（§12.1/ADR 006）
  targetUnitId String // ground truth 連結（永不直接下發前端）
  fidelity     IntelFidelity
  lastSeenTick Int
  lastSeenLat  Float
  lastSeenLng  Float
  errorRadiusM Float

  @@index([sessionId, faction])
}

// ==========================================
// 7. Checkpoints / AI Logs / AAR / Plugins
// ==========================================

model SimCheckpoint {
  id        String   @id @default(uuid())
  sessionId String
  tick      Int
  // 快照當下的 ledger tip seq。rollback 後 tick 非單調，seq 才是時間軸身分（O1.7/R3）：
  // load_latest 依 ledgerSeq 排序、events_after 以 seq 計數。
  ledgerSeq Int
  stateBlob Bytes // zstd 壓縮完整狀態
  stateHash String // golden replay 驗證用
  createdAt DateTime @default(now())

  @@unique([sessionId, tick])
}

model AIInvocationLog {
  id              String   @id @default(uuid())
  sessionId       String?
  role            String // STRATEGIC_PLANNER / OPFOR_COMMANDER / ...
  adapter         String // LoRA adapter 版本
  promptHash      String
  request         Json
  response        Json
  latencyMs       Int
  tokensIn        Int
  tokensOut       Int
  guardrailResult Json // G1–G6 通過/攔截明細
  createdAt       DateTime @default(now())

  @@index([sessionId, role])
}

model AARReport {
  id          String   @id @default(uuid())
  sessionId   String   @unique
  narrative   Json // 結構化段落 + event id 引用
  metrics     Json
  generatedAt DateTime @default(now())
}

model PluginRegistry {
  id          String  @id @default(uuid())
  name        String  @unique
  kind        String // TERRAIN / WEATHER / VISION / AI_ROLE / CUSTOM
  endpoint    String
  contractVer String
  healthState String // HEALTHY / DEGRADED / DOWN
  config      Json
  enabled     Boolean @default(true)
}

/// 火力計畫（WP-C10.3）：預劃目標清單。**陣營私有**——查詢一律在後端依 faction 過濾。
model FirePlan {
  id                     String           @id @default(uuid())
  sessionId              String
  faction                String
  name                   String
  status                 FirePlanStatus   @default(ACTIVE)
  /// 建立者的 SessionParticipant.id。自動執行的令**以建立者的身分送出**——
  /// 沒有「系統」這個下令者（validate_order 要求 issuer 是本局參與者），
  /// 而預劃火力的當責者本來就是寫這份計畫的人。
  createdByParticipantId String?
  createdAtTick          Int
  createdAt              DateTime         @default(now())
  targets                FirePlanTarget[]

  @@index([sessionId, faction])
}

/// 預劃目標（打座標）。執行方式就是下一道 FIRE_MISSION 令（WP-C10.2），不另生物理。
model FirePlanTarget {
  id            String               @id @default(uuid())
  planId        String
  plan          FirePlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// 計畫內序號：排程器依此排序執行，**順序必須確定**才可重播。
  seq           Int
  label         String?
  targetLat     Float
  targetLng     Float
  rounds        Int                  @default(4)
  /// 執行此目標的砲兵單位。系統不自動挑砲——自動指派屬 WP-C10.4。
  shooterUnitId String
  schedule      FireSchedule         @default(ON_CALL)
  atTick        Int?
  /// 本局要求火協時掛的已核准 FIRE_SUPPORT 申請單。一張只兌現一次，故逐目標而非整份共用。
  fireRequestId String?
  status        FirePlanTargetStatus @default(PENDING)
  orderId       String?
  firedAtTick   Int?
  failureReason String?              @db.Text

  @@index([planId, seq])
}

enum FirePlanStatus {
  ACTIVE
  CANCELLED
}

enum FireSchedule {
  /// 到指定 tick 自動下令（攻擊準備射擊）。
  AT_TICK
  /// 待命，由 FSO 席位呼叫。
  ON_CALL
}

enum FirePlanTargetStatus {
  PENDING
  /// 令已送出（order_id 指向該令）。**不代表打中**——裁決失敗的令以零毀傷 COMPLETED。
  FIRED
  /// 下令被擋（驗證/預檢/火協），原因見 failureReason。
  FAILED
  /// 計畫被取消時尚未執行者。
  SKIPPED
}


/// 演習專案（WP-B1，SPEC_V2 §6）——把多次預推、正式局、檢討裝在一起的容器。
/// [JCATS-A p.9–16 圖7] 的 17 步 SOP：一場演習遠大於一局模擬。
///
/// **與 session 是兩條獨立的軸**：演習的 `phase` 講的是演習流程走到哪；
/// session 的 `archivedAt` 講的是那一局有沒有被封存。混為一談會讓局從錯的清單裡消失。
model Exercise {
  id             String        @id @default(uuid())
  name           String
  phase          ExercisePhase @default(PREP)
  /// 行程表（自由結構的鍵值對；D-45 想定發佈之類）。
  scheduleJson   Json?
  /// 整備勾稽項：[{key, label, phase, required, done, done_at, done_by}]。
  /// **required 且未勾就推不動階段**——只是提示的話與沒有無異。
  checklistJson  Json?
  createdBy      String
  createdAt      DateTime      @default(now())
  /// 最近一次階段推進的**真實牆鐘**時間（這不是模擬時間，故不受 SimClock 紅線約束）。
  phaseChangedAt DateTime?

  audit ExerciseAuditLog[]
}

/// 演習稽核軌跡（WP-B1）。**刻意不寫 TacticalEventLog**：那是 golden 會驗的雜湊鏈，
/// 而階段推進是牆鐘的、人為的、局外的事件——寫進鏈裡會擾動決定性重播。
model ExerciseAuditLog {
  id         String         @id @default(uuid())
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  /// 演習內單調遞增序號。**沒有它，同一秒內的兩筆稽核順序就是隨機的**——
  /// 順序隨機的稽核軌跡讀不出「先勾了項目才推階段」還是反過來。
  seq        Int
  at         DateTime       @default(now())
  actorId    String
  action     String
  fromPhase  ExercisePhase?
  toPhase    ExercisePhase?
  detail     Json?

  @@unique([exerciseId, seq])
}

enum ExercisePhase {
  /// 整備（會議、想定發佈、飽和測試）
  PREP
  /// 預推
  REHEARSAL
  /// 正式實施（WP-B4 於此階段簽證鎖定參數）
  EXECUTION
  /// 檢討
  REVIEW
  /// 撤收建檔
  ARCHIVED
}

enum SessionRole {
  REHEARSAL
  MAIN
  ANALYSIS
}


/// 參數簽證（WP-B4，[JCATS-A p.14,25–26]「參數確認後簽證鎖定不得再改」）。
///
/// 一場演習最多一份（`@@unique`）。`snapshotBlob` 是 zstd 壓縮的 canonical JSON
/// （EquipmentTemplate 全表 + 正規化後的 SimParams + 機動矩陣內容）；
/// `contentHash` 是同一份內容的 sha256——**開局比對它**，不符即拒起。
model ParameterSeal {
  id           String   @id @default(uuid())
  exerciseId   String   @unique
  sealedAt     DateTime @default(now())
  sealedBy     String
  contentHash  String
  snapshotBlob Bytes
}
