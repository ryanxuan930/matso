{
  "title": "MATSO — 演習總覽",
  "uid": "exercise-overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 0,
      "title": "執行中的推演局",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "matso_active_sessions",
          "legendFormat": "sessions",
          "refId": "A"
        }
      ]
    },
    {
      "id": 1,
      "title": "WS 扇出 / 秒",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(matso_ws_fanout_total[1m])",
          "legendFormat": "events/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "I/O p95 (ms)",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(matso_io_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "tick / 秒",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(matso_tick_total[1m])",
          "legendFormat": "tps",
          "refId": "A"
        }
      ]
    }
  ]
}
