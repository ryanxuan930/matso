{
  "title": "MATSO — AI 健康",
  "uid": "ai-health",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 0,
      "title": "LLM p95 (ms)",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(matso_llm_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 1,
      "title": "AI worker 數",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "matso_ai_workers",
          "legendFormat": "workers",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "護欄攔截 / 分",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(matso_guardrail_blocked_total[1m]) * 60",
          "legendFormat": "blocked",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "LLM 呼叫 / 分",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(matso_llm_latency_ms_count[1m]) * 60",
          "legendFormat": "calls",
          "refId": "A"
        }
      ]
    }
  ]
}
