{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "matso:orbat:0.1.0",
  "title": "OrbatFile",
  "description": "單一陣營的戰鬥序列（orbat/<faction>.yaml，SPEC_FULL §11.1）。巢狀單位樹以 parent 參照。",
  "type": "object",
  "required": [
    "faction",
    "units"
  ],
  "additionalProperties": false,
  "properties": {
    "faction": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,31}$"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "designation",
          "unit_level"
        ],
        "additionalProperties": false,
        "properties": {
          "designation": {
            "type": "string",
            "minLength": 1
          },
          "unit_level": {
            "enum": [
              "THEATER",
              "ARMY_GROUP",
              "ARMY",
              "CORPS",
              "DIVISION",
              "BRIGADE",
              "REGIMENT",
              "BATTALION",
              "COMPANY",
              "PLATOON",
              "SECTION",
              "SQUAD",
              "FIRETEAM",
              "INDIVIDUAL"
            ]
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "parent": {
            "type": "string",
            "description": "上級單位 designation（同 orbat 內）"
          },
          "fixed": {
            "type": "boolean",
            "description": "固定單位（指揮部/後勤/陣地等）：不接受 MOVE 令、不會被派去移動或機動交戰。預設 false。"
          },
          "equipment": {
            "type": "array",
            "description": "本單位的編裝（WP-B6）。範本以**名稱**參照 EquipmentTemplate.name（如 RIFLE_556 / MBT / HOWITZER_155_SP）；未知名稱於開局時報錯並指出精確路徑（SPEC_FULL §11.1）。省略此欄＝沿用開局旗標 seed_default_equipment 的預設配發。",
            "items": {
              "type": "object",
              "required": [
                "template"
              ],
              "additionalProperties": false,
              "properties": {
                "template": {
                  "type": "string",
                  "minLength": 1,
                  "description": "EquipmentTemplate.name"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1,
                  "description": "建制數量（squad 齊射的射手數 / 車輛數）"
                },
                "ammo": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "初始彈藥；省略＝由範本的 baseStats 決定（0）"
                }
              }
            }
          },
          "branch": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "INFANTRY",
              "ARMOR",
              "RECON",
              "ARTILLERY",
              "AIR_DEFENSE",
              "ENGINEER",
              "MISSILE",
              "AVIATION",
              "SIGNAL",
              "INTEL",
              "SUPPLY",
              "MEDICAL",
              "MAINTENANCE",
              "TRANSPORT",
              "HQ"
            ],
            "default": "UNKNOWN",
            "description": "兵科——決定地圖符號的 2525C function ID（步兵斜線／裝甲橢圓／砲兵圓點…）。省略＝UNKNOWN＝通用框，既有想定零變更。"
          }
        }
      }
    }
  }
}
