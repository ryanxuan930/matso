{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "matso:scenario:0.1.0",
  "title": "ScenarioPackage",
  "description": "scenario.yaml 的驗證 schema（SPEC_FULL §11.1、§12.1）。載入器 MUST 回報精確錯誤路徑。orbat 各檔見 orbat.schema.json；roe/msel 的 $defs 於 O7.2/O7.3 補完。",
  "type": "object",
  "required": [
    "name",
    "version",
    "bbox",
    "mode",
    "tick_rate_ms",
    "factions",
    "victory_conditions"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "bbox": {
      "type": "array",
      "description": "[min_lng, min_lat, max_lng, max_lat] WGS84",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "mode": {
      "enum": [
        "REALTIME",
        "WEGO",
        "IGO_UGO"
      ]
    },
    "tick_rate_ms": {
      "description": "1 tick 的模擬時間（ms）。60000 ＝ 1 分。此值會決定該局執行期的節奏——速度、耗損、每日消耗全部以它為分母。",
      "type": "integer",
      "minimum": 100,
      "default": 60000
    },
    "hex_resolution": {
      "description": "戰術格網的 h3 解析度。**目前只支援 8**：core 的地形取樣/路徑規劃/預檢皆固定在該解析度，宣告別的值 loader 會直接拒載（而不是靜默忽略）。",
      "type": "integer",
      "const": 8,
      "default": 8
    },
    "aggregate_adjudication_level": {
      "enum": [
        "BATTALION",
        "BRIGADE",
        "DIVISION"
      ],
      "default": "BATTALION",
      "description": "此層級(含)以上使用 Lanchester 聚合裁決（SPEC_FULL §7.1）"
    },
    "factions": {
      "type": "array",
      "description": "本局交戰陣營宣告（SPEC §12.1/ADR 006）。WHITE_CELL 為統裁保留字，不得列入。",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,31}$"
          },
          "display_name": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "description": "陣營關係上三角宣告（對稱）。未宣告配對預設 HOSTILE。",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          },
          {
            "enum": [
              "ALLIED",
              "NEUTRAL",
              "HOSTILE"
            ]
          }
        ],
        "minItems": 3,
        "maxItems": 3
      }
    },
    "victory_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "faction",
          "condition"
        ],
        "properties": {
          "faction": {
            "type": "string",
            "description": "須為 factions 宣告的陣營 id（載入器語意驗證）"
          },
          "condition": {
            "type": "object",
            "description": "條件 DSL 於 O7.2 定義（與 MSEL trigger 共用）"
          }
        }
      }
    },
    "files": {
      "type": "object",
      "description": "package 內各檔的相對路徑宣告（orbat 每陣營一檔）",
      "properties": {
        "orbat": {
          "type": "object",
          "description": "faction id → orbat yaml 相對路徑",
          "additionalProperties": {
            "type": "string"
          }
        },
        "roe": {
          "type": "string",
          "default": "roe.yaml"
        },
        "msel": {
          "type": "string",
          "default": "msel.yaml"
        },
        "weather_script": {
          "description": "⚠ **尚未實作**：core 沒有任何天氣腳本來源，宣告了 loader 會直接拒載（而不是靜默忽略）。演習中改天氣請用 MSEL 的 WEATHER_OVERRIDE 注入。",
          "type": "string"
        },
        "overrides_dir": {
          "type": "string"
        }
      }
    },
    "no_strike_zones": {
      "type": "array",
      "description": "禁射區（WP-A3）。護欄 G4 與人類下令 precheck 皆以此判定：目標**實際位置**落在區內即攔。NO_STRIKE＝硬阻擋（AI 令被剔除、人類令被拒）；RESTRICTED_FIRE＝不硬擋，升白軍確認（人類需明確 override，且 override 記入 Ledger 供 AAR 追究）。",
      "items": {
        "type": "object",
        "required": [
          "name",
          "zone_class",
          "geometry"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "區域名稱（醫院、文化資產、平民聚落…）"
          },
          "zone_class": {
            "type": "string",
            "enum": [
              "NO_STRIKE",
              "RESTRICTED_FIRE"
            ]
          },
          "geometry": {
            "type": "object",
            "required": [
              "type"
            ],
            "description": "GeoJSON 慣例的 [lng, lat] 順序（與 MapFeature 一致）",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "polygon",
                  "circle"
                ]
              },
              "ring": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "description": "polygon：開放環 [[lng,lat],…]（不閉合，同 MapFeature）"
              },
              "center": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                },
                "description": "circle：[lng, lat]"
              },
              "radius_m": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "circle：半徑（公尺）"
              }
            }
          }
        }
      }
    },
    "supply_points": {
      "type": "array",
      "description": "補給點（WP-C7.2）。開局落地為 `MapFeature(kind=\"SUPPLY_POINT\")`：低於再訂購水位的單位**自己來拉**（拉不是推——推送要求補給點知道全場有誰缺什麼，而且會讓「補給線被切斷」變得無法表達），拉得到的半徑是引擎常數 3 km。打掉它，半徑內的單位水位就不再回升——**這是「打擊敵後勤」成為可行戰法的那一塊**。省略＝本局沒有補給點＝自動撥交與整補每 tick 一次查詢之外什麼都不做。⚠ 補給點是**靜態**的：它不會跟著部隊走，也沒有任何機制把後方的貨推到前方。前推補給是把補給單位（`branch: SUPPLY`）開上去、走 RESUPPLY 令，不是移動這個點。座標刻意用具名的 `lat`/`lng` 而不是 `no_strike_zones` 那種位置陣列：GeoJSON 的 `[lng, lat]` 順序一寫反，執行期就是一個目標都抓不到而且**不會報錯**，具名鍵讓那個順序只在載入器裡出現一次。",
      "items": {
        "type": "object",
        "required": [
          "name",
          "faction",
          "lat",
          "lng",
          "stock"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "補給點名稱（落地為 MapFeature.label，AAR 與地圖上看到的就是它）"
          },
          "faction": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,31}$",
            "description": "擁有陣營（須為 factions 宣告過的；載入器會擋打錯字的陣營）。**只有同陣營的單位拉得到貨**——盟軍共用是後勤協定問題不是物理問題，預設不共用比較保守。"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "stock": {
            "type": "object",
            "description": "各類別庫存（倉庫無容量上限概念，只有存量）。單位與 orbat `supply` 的抽象量相同。只收 I 與 IX，理由見 orbat.schema.json 的 `unitSupply`：III/V 在這裡宣告也不會有人來拉（單位身上根本沒有那兩個類別的水位）。至少要有一項 > 0，否則這個點從第一個 tick 起就不可用（載入器會擋）。",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "I": {
                "type": "number",
                "minimum": 0
              },
              "IX": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "request_quotas": {
      "type": "object",
      "description": "申請單配額（WP-B5.2，[JCATS-A p.13] 空偵架次）。缺／未列的種類＝不限。**目前是整局總量，不是每日**——SimClock 沒有「模擬日」概念，硬做每日重置會是假的（見 docs/worklog/c2-messaging.md）。",
      "properties": {
        "AIR_RECON": {
          "type": "integer",
          "minimum": 0
        },
        "FIRE_SUPPORT": {
          "type": "integer",
          "minimum": 0
        },
        "RESUPPLY_VOUCHER": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "day_night": {
      "type": "object",
      "additionalProperties": false,
      "description": "晝夜宣告（WP-C4a）。省略＝整場都是白天（所有光照係數 1.0，既有想定零變更）。日出日落用**想定參數**而非天文計算：兵推要的是「白天打還是晚上打」，而夜訓本來就會挑時間。",
      "properties": {
        "sunrise_min": {"type": "integer", "minimum": 0, "maximum": 1439, "description": "日出時刻（當日分鐘數，0=00:00）"},
        "sunset_min": {"type": "integer", "minimum": 0, "maximum": 1439, "description": "日落時刻（當日分鐘數）。可小於 sunrise_min＝跨午夜的夜間。"},
        "start_min": {"type": "integer", "minimum": 0, "maximum": 1439, "description": "開演時刻（tick 0 對應的當日分鐘）。省略＝午夜開演。"}
      },
      "required": ["sunrise_min", "sunset_min"]
    },
    "allow_fratricide": {
      "type": "boolean",
      "description": "友軍誤傷裁決（WP-C9）：開啟時對**自己陣營/盟軍**的 ENGAGE 不再被 ROE 拒絕，改為強警告＋照常裁決＋記 FRATRICIDE 事件供 AAR 追究。**不涵蓋中立方**（攻中立仍一律拒）。面射擊（FIRE_MISSION）不受本開關影響——砲彈不挑陣營，殺傷半徑內友軍本來就會受傷。省略＝false＝維持既有的「非敵對一律拒」（既有想定零變更）。"
    },
    "indirect_fire_requires_approval": {
      "type": "boolean",
      "description": "曲射火協（WP-B5.3）：開啟時 ARTILLERY/MISSILE 的 ENGAGE 令須掛已核准的 FIRE_SUPPORT 申請單，否則預檢拒絕。省略＝false＝不設限（既有想定零變更）。"
    },
    "survivability_move": {
      "type": "object",
      "description": "陣地變換（WP-C10.5）：砲兵打了 N 次火力任務後自動位移，避免被反砲兵火力找到。省略＝停用（既有想定零變更）。**計的是「火力任務次數」不是「發數」**——發數由下令者自填、`rounds_per_mission` 又沒有任何程式讀，兩者都不是穩定的單位。只有能自走的砲（TRACKED/WHEELED）會被排程；牽引砲需要牽引車，那條路徑尚無資料模型。",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "missions_before_move": {
          "type": "integer",
          "minimum": 1,
          "description": "打幾次火力任務後換陣地"
        },
        "min_km": {
          "type": "number",
          "minimum": 0.1,
          "description": "位移距離下限（km）"
        },
        "max_km": {
          "type": "number",
          "minimum": 0.1,
          "description": "位移距離上限（km）"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
